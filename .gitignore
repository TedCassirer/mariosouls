# Source control only. Local runtime archives and game-derived data stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/MarioSouls.ps1
!/CONTRIBUTING.md
!/docs/
/docs/*
!/docs/*.md
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/*.md
!/AGENTS.md
!/framework/
/framework/**
!/framework/**/
!/framework/**/*.h
!/framework/**/*.cpp
!/framework/**/*.cs
!/framework/**/*.c
!/framework/**/*.def
!/framework/**/*.py
!/framework/**/*.json
!/framework/**/*.in
!/framework/**/*.md
!/dependencies.lock.json
!/tools/
/tools/*
!/tools/**/*.py
!/tools/README.md
# Historical checkpoint manifests and archives remain local.
!/patches/
/patches/*
!/patches/*.patch
!/patches/libsm64/
/patches/libsm64/*
!/patches/libsm64/host_pose.h
# Local builds, dependencies, investigations and deliverables are private.
/work/
/outputs/

!/LICENSE
!/THIRD_PARTY.md
!/CHANGELOG.md
!/SECURITY.md
!/requirements-assets.txt
!/licenses/
/licenses/*
!/licenses/*.txt
!/release/
/release/*
!/release/*.json
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/dependabot.yml

!/.clang-format
!/.editorconfig
!/pyproject.toml
!/requirements-dev.txt
**/__pycache__/
